model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

	annotation PBI_QueryOrder = ["Fact_Orders","Dim_Returns","Dim_People","Dim_Date","ExcelFilePath"]

	ref table Fact_Orders
	ref table Dim_Returns
	ref table Dim_People
	ref table Dim_Date
